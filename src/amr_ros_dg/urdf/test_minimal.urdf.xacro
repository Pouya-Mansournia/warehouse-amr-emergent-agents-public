<?xml version="1.0"?>
<!-- Ultra-minimal: just a box + ONE wheel to debug motor/collision/physics -->
<robot name="test_minimal" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_link">
    <inertial>
      <mass value="5.0" />
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
    </inertial>
    <visual>
      <geometry>
        <box size="0.5 0.3 0.2" />
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.5 0.3 0.2" />
      </geometry>
    </collision>
  </link>

  <link name="wheel">
    <inertial>
      <mass value="0.5" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
    </collision>
  </link>

  <joint name="wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="wheel" />
    <origin xyz="0 0.15 -0.15" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.0" friction="0.0" />
  </joint>

  <gazebo reference="wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <ros2_control name="test_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10.0</param>
        <param name="max">10.0</param>
      </command_interface>
      <state_interface name="velocity" />
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find amr_ros_dg)/config/amr_ros_dg_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
