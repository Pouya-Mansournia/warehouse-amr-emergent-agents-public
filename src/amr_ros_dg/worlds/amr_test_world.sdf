<?xml version="1.0" ?>
<!-- Minimal test world, used instead of ros_gz_sim's bundled empty.sdf.
     Needed specifically because the d435i/floor cameras and the ultrasonic ring
     (urdf/amr_ros_dg.urdf.xacro) are real gz-sim <sensor> elements now, and camera/lidar
     rendering requires the "Sensors" system plugin to be loaded by the WORLD, not the
     model - the bundled empty.sdf can't be relied on to have that (it's meant for basic
     physics-only scenes with no rendered sensors). Everything else here (ground plane,
     sun, physics/scene-broadcaster/user-commands/contact systems) matches what a normal
     gz-sim empty world already provides, just made explicit here alongside Sensors. -->
<sdf version="1.9">
  <world name="amr_test_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <!-- ogre2 is required for camera/lidar sensors to actually render and publish data -
         without this plugin, <sensor type="camera"/"gpu_lidar"> elements exist in the SDF
         but silently never produce any topic output. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
