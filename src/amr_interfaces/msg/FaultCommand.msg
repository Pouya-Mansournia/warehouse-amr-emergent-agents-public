# Publish on /fleet/faults/command to inject or clear a fault.
# One message = one instruction, not an ongoing stream - robot_health/fault_injector emits
# these on manual/scheduled/seeded-random trigger and on explicit clear; robot_health/
# health_monitor is the sole subscriber that acts on them.

string robot_id         # target robot namespace (e.g. "robot1"), or "*" for fleet-wide
string fault_type       # e.g. "LOW_BATTERY", "LIDAR_DROPOUT" - see robot_health/faults.py
float32 severity        # 0..1, meaning is fault_type-specific
float32 duration_sec    # 0 means "until explicitly cleared"
string trigger_source   # "manual" | "scheduled" | "seeded_random"
string fault_id         # unique per injected fault instance, generated by fault_injector
bool clear              # true = cancel the active fault matching (robot_id, fault_type)
builtin_interfaces/Time stamp
