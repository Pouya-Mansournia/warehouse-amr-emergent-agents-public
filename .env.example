# This project's default LLM backend is a LOCAL Ollama server (no API
# key required). These variables are only needed if you configure a
# cloud LLM provider instead of local Ollama - copy this file to .env
# and fill in real values there. Never commit a real .env file.

# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
# GOOGLE_API_KEY=your_key_here

# Local Ollama server address (default shown)
OLLAMA_HOST=http://localhost:11434
